# Copy to .env if you want to override docker-compose defaults.
# Never commit real secrets. The values below are for local development only.

ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (docker-compose service name is "postgres")
DATABASE_URL=postgresql+psycopg://agentforge:agentforge@postgres:5432/agentforge
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=agentforge
POSTGRES_DB=agentforge

# Redis
REDIS_URL=redis://redis:6379/0

# Required in production. Use a long random string (32+ characters).
JWT_SECRET=dev-only-change-me-agentforge-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# LLM. "mock" runs a deterministic local provider and needs no API key.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# Comma-separated browser origins for local Vite and the Compose frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

RATE_LIMIT_PER_MINUTE=120
TASK_RATE_LIMIT_PER_MINUTE=30
LOGIN_RATE_LIMIT_PER_MINUTE=20

RETRY_BASE_SECONDS=1
RETRY_MAX_SECONDS=60

SEED_DEMO=true
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=DemoPass123!
ADMIN_USER_EMAIL=admin@example.com
ADMIN_USER_PASSWORD=AdminPass123!

# Enable only behind a trusted reverse proxy (the Compose frontend sets this).
TRUST_PROXY=false

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
